<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LearnEnglish">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ExerciseActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".VocabularyActivity" android:exported="false" />
        <activity android:name=".LessonSummaryActivity" android:exported="false" />
        <activity android:name=".VocabQuizActivity" android:exported="false" />
        <activity android:name=".CreateSetActivity" android:exported="false" />
        <activity android:name=".UnitDetailActivity" android:exported="false" />
        <activity android:name=".LearnVocabActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".WriteVocabActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".MatchVocabActivity" android:exported="false" />
        <activity android:name=".TestVocabActivity" android:exported="false" />
        <activity android:name=".DayActivity" android:exported="false" />
        <activity android:name=".CreateLessonActivity" android:exported="false" />
        <activity android:name=".AddVocabActivity" android:exported="false" />
        <activity android:name=".AddGrammarQuizActivity" android:exported="false" />

    </application>

</manifest>