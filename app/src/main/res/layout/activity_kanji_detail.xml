<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/white"
        android:gravity="center_vertical"
        android:elevation="2dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:tint="#1F2937" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLessonTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bài 1: Chữ số (1 - 7)"
                android:textColor="#1F2937"
                android:textSize="17sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvLessonSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7 chữ Kanji"
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStartQuiz"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Thi thử"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#EF4444"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

    <!-- Sub-tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_tab_container"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/tabFlashcard"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🎴 Thẻ ghi nhớ"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_tab_active_red" />

            <TextView
                android:id="@+id/tabKanjiList"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="📋 Danh sách Kanji"
                android:textColor="#4B5563"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@android:color/transparent" />

            <TextView
                android:id="@+id/tabReading"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="📖 Đọc câu"
                android:textColor="#4B5563"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@android:color/transparent" />

            <TextView
                android:id="@+id/tabWriting"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="✍️ Luyện viết"
                android:textColor="#4B5563"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@android:color/transparent" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Content Containers -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 1. Flashcard Container -->
        <ScrollView
            android:id="@+id/containerFlashcard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardFlashcard"
                android:layout_width="match_parent"
                android:layout_height="340dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@android:color/white">

                <!-- Front Side: Kanji Character -->
                <LinearLayout
                    android:id="@+id/cardFront"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/tvCardIndex"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 / 7"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCardKanji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="一"
                        android:textColor="#1E293B"
                        android:textSize="100sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCardHanViet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="NHẤT"
                        android:textColor="#EF4444"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Chạm vào thẻ để xem âm Kun, On &amp; từ ghép"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Back Side: Details & Examples -->
                <ScrollView
                    android:id="@+id/cardBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="20dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvCardBackKanji"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="一"
                                android:textColor="#1E293B"
                                android:textSize="36sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCardBackHanViet"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="NHẤT"
                                android:textColor="#EF4444"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <ImageButton
                                android:id="@+id/btnSpeakCard"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_speaker"
                                android:tint="#EF4444" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E2E8F0"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Âm Kun (Kunyomi):"
                            android:textColor="#64748B"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCardKunyomi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ひと"
                            android:textColor="#0F172A"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Âm On (Onyomi):"
                            android:textColor="#64748B"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCardOnyomi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="イチ"
                            android:textColor="#0F172A"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Từ ghép minh họa:"
                            android:textColor="#64748B"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCardExamples"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="一人で, 一つ, 一日, 一生懸命"
                            android:textColor="#334155"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </ScrollView>
            </androidx.cardview.widget.CardView>

            <!-- Navigation Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPrevCard"
                    android:layout_width="120dp"
                    android:layout_height="48dp"
                    android:text="← Trước"
                    android:textColor="#475569"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="#E2E8F0"
                    android:layout_marginEnd="16dp" />

                <Button
                    android:id="@+id/btnNextCard"
                    android:layout_width="120dp"
                    android:layout_height="48dp"
                    android:text="Sau →"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="#EF4444" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

        <!-- 2. Kanji List Container -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvKanjiList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:clipToPadding="false"
            android:visibility="gone" />

        <!-- 3. Reading Sentences Container -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvReading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:clipToPadding="false"
            android:visibility="gone" />

        <!-- 4. Writing Practice Container -->
        <ScrollView
            android:id="@+id/containerWriting"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/layoutWritingItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </FrameLayout>
</LinearLayout>
